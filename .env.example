# Public browser-safe Supabase keys
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy Supabase browser key fallback
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional explicit server-side copy of the same project URL
SUPABASE_URL=https://your-project.supabase.co

# Preferred server-side Supabase key
SUPABASE_SECRET_KEY=your-secret-key

# Legacy Supabase server key fallback
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional direct/pooler Postgres URL for remote migration scripts
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require

# Server-side email
RESEND_API_KEY=your-resend-api-key

# Website + email routing
SITE_URL=https://www.ballooncraftkc.com
CONTACT_EMAIL_TO=you@example.com
CONTACT_EMAIL_FROM=noreply@updates.ballooncraftkc.com
DEVELOPER_EMAIL_TO=developer@example.com

# Theme + deployment helpers
VITE_NEW_DESIGN_ACTIVE_THEME=rainbow_birthday
VITE_VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/your-hook-url
